@using MVCfromScratch.Models
@model Category

@section title {
    <h1>Welcome to Super-Supermarket Home Page!</h1>
}

<partial name="_Category" model="@Model" />

@if (Model != null)
{
    <h3>Category @Model.CategoryId: &emsp; @Model.Name </h3>
}

<form method="post" asp-controller="categories" asp-action="edit">
    <input type="hidden" asp-for="CategoryId" />
    <div class="text-danger" asp-validation-summary="All"></div>
    <span class="text-danger" asp-validation-for="Description"></span>


</form>