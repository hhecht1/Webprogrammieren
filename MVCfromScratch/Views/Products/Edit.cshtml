@model MVCfromScratch.ViewModels.ProductViewModel

<partial name="_Product" model="@Model" />

@section title {
    @if (Model != null)
    {
        <h3>Edit Product: @Model.Product?.Name</h3>
    }
}

<form method="post" asp-controller="products" asp-action="edit">
    <input type="hidden" asp-for="Product.ProductId" />


    
 
</form>