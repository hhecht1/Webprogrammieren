@using MVCfromScratch.Models
@model List<Product>


@section title {
    <h3>Products</h3>
}

@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price?</td>
                    <td>@product.Quantity</td>
                    <td>@product.Category?.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products available.</p>
}