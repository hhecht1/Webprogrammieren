@model IEnumerable<TechCamp.Models.Raum>

@{
    ViewData["Title"] = "Räume";
}

<h1>Räume</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        + Neuer Raum
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bezeichnung</th>
            <th>Gebäude</th>
            <th>Kapazität</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var raum in Model)
        {
            <tr>
                <td>@raum.Bezeichnung</td>
                <td>@raum.Gebäude</td>
                <td>@raum.Kapazität Personen</td>
            </tr>
        }
    </tbody>
</table>