@model IEnumerable<TechCamp.ViewModels.DozentÜbersichtVM>

@{
    ViewData["Title"] = "Dozentenübersicht";
}

<h1>Dozentenübersicht</h1>

<p>
    Alle Dozenten werden angezeigt – auch wenn sie aktuell
    keinem Kurs zugeordnet sind.
</p>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Fachgebiet</th>
            <th>Anzahl Kurse</th>
        </tr>
    </thead>

    <tbody>

        @foreach (TechCamp.ViewModels.DozentÜbersichtVM dozent in Model)
        {
            <tr>

                <td>
                    @dozent.Vorname @dozent.Nachname
                </td>

                <td>
                    @dozent.Fachgebiet
                </td>

                <td>
                    @dozent.KursAnzahl
                </td>

            </tr>
        }

    </tbody>

</table>

<a asp-controller="Dozenten" asp-action="Create" class="btn btn-primary">
    + Neuer Dozent
</a>

<a asp-controller="Kurse" asp-action="Index" class="btn btn-secondary">
    Zurück zu den Kursen
</a>